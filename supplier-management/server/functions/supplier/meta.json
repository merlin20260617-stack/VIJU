{
  "name": "供应商平台业务操作",
  "description": "集团成员查询供应商、物料及供货关系，采购维护供应商与供货，中央仓维护物料，技术人员独立确认适配；服务端按本人角色校验，不管理成员权限。",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "operation": {
        "type": "string",
        "enum": [
          "snapshot",
          "save",
          "import",
          "attach"
        ],
        "description": "snapshot只读加载供应商、物料及供货关系；save维护一条业务记录；import预览或提交受控批量资料；attach追加新附件，均由服务端核验职责"
      },
      "target": {
        "description": "save/import/attach的固定业务对象；technical只更新已有供货关系的技术适配结论，snapshot不传",
        "type": "string",
        "enum": [
          "supplier",
          "material",
          "mapping",
          "technical"
        ]
      },
      "commandJson": {
        "description": "save传recordId和fields；import传mode(新增/更新)、rows及preview布尔值；attach传recordId及files数组。记录ID来自snapshot；不传身份、表ID或权限。",
        "type": "string",
        "maxLength": 500000
      }
    },
    "required": [
      "operation"
    ]
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "payload": {
        "type": "string"
      }
    },
    "required": [
      "payload"
    ],
    "additionalProperties": false
  },
  "contract": {
    "version": 1,
    "generatorVersion": "1.6.0",
    "sdkVersion": "0.3.2",
    "schemaVendor": "zod",
    "schemaPackageVersion": "4.6.5",
    "schemaHash": "sha256:f3df2c86003d4ee9eafd0da329e7e3ceba74192003341c45f6f92c2f4056030f",
    "fidelity": "complete",
    "mode": "discovery",
    "warnings": []
  }
}
